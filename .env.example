DATABASE_URL=sqlite:////data/energytool.db
APP_PORT=8000
# PostgreSQL: postgresql+psycopg://energytool:CHANGE_ME@postgres:5432/energytool
APP_ORIGIN=http://localhost:8000
# Включить при работе сайта через HTTPS.
COOKIE_SECURE=false
# Явный тестовый режим до подключения ядра Данька.
CORE_MODE=stub
CORE_DEMO=false
# Для проверки ядра без API: CORE_MODE=real и CORE_DEMO=true.
# Для настоящей базы/Qwen: CORE_MODE=real и CORE_DEMO=false.
CORE_MODULE=consultant_core
# Таймаут адаптера async answer(history), не более 120 секунд.
CORE_TIMEOUT_SECONDS=120
# Провайдер локальной разработки; платформа задаёт собственные значения.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DATA_DIR=/knowledge
# Закрытая база монтируется отдельно через compose.knowledge.yaml.
# KNOWLEDGE_DIR=/absolute/path/to/private/data
