DATABASE_URL=sqlite:////data/energytool.db
# PostgreSQL: postgresql+psycopg://energytool:CHANGE_ME@postgres:5432/energytool
APP_ORIGIN=http://localhost:8000
# Enable when serving over HTTPS.
COOKIE_SECURE=false
CORE_MODE=real
CORE_MODULE=consultant_core
# Таймаут адаптера async answer(history), не более 120 секунд.
CORE_TIMEOUT_SECONDS=120
# Local provider; platform will supply its own environment for solution.py.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
DATA_DIR=/knowledge
