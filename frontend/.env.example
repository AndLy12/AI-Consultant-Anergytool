# Адрес локального backend роли №1 для dev-прокси Vite.
# Секретов здесь нет и быть не должно: ключи модели живут только на сервере.
VITE_API_TARGET=http://localhost:8001

# Origin, который backend считает своим (переменная APP_ORIGIN в его .env).
# Dev-прокси подставляет именно это значение, иначе backend ответит 403.
VITE_API_ORIGIN=http://localhost:8001
